{
  "name": "pod-agent-os",
  "version": "0.1.0",
  "private": true,
  "description": "POD Agent OS — an agent-run print-on-demand operating system around Shopify, Etsy, and Printify.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
