# POD Agent OS — environment variables
# Copy to .env and fill in. NEVER commit real values.

# --- Shopify (headless commerce backend) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=        # public-scoped, safe for the client
SHOPIFY_ADMIN_TOKEN=             # secret, server-only
SHOPIFY_WEBHOOK_SECRET=          # from Shopify Partner/Admin > Webhooks

# --- Printify (product creation + fulfillment) ---
PRINTIFY_TOKEN=
PRINTIFY_SHOPIFY_SHOP_ID=
PRINTIFY_ETSY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=         # random string you set when registering the Printify webhook URL

# --- Etsy (marketplace; via Printify + own API layer) ---
ETSY_CLIENT_ID=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=                    # numeric Etsy shop ID for direct API calls
ETSY_SHIPPING_PROFILE_ID=        # numeric shipping profile ID for draft listings

# --- Pinterest (traffic) ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=              # board ID where product pins are published

# --- Analytics ---
GA4_PROPERTY_ID=

# --- DataForSEO (research) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Anthropic (Claude Agent SDK) ---
ANTHROPIC_API_KEY=

# --- Supabase (database + storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=               # public-scoped, safe for the client
SUPABASE_SERVICE_ROLE_KEY=       # secret, server-only

# --- Inngest (durable/scheduled workflows) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
